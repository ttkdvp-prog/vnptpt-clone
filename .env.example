# Server only — Google Sheets API (Service Account), never prefix with NEXT_PUBLIC_
GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@your-project.iam.gserviceaccount.com
# Paste the private_key from the Service Account JSON as-is (with \n escapes) — Vercel dashboard keeps \n literal
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=change-me-spreadsheet-id
# Google Drive folder (share it with the Service Account email) — used for uploaded images
GOOGLE_DRIVE_FOLDER_ID=change-me-drive-folder-id

JWT_SECRET=change-me-to-a-long-random-string
AUTH_SECRET=change-me-to-a-long-random-string
API_PORT=3001
API_ORIGIN=http://localhost:3001
# Comma-separated allowed browser origins (CORS). Production example:
# CLIENT_ORIGINS=https://your-app.vercel.app,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Client — data source: mock | api
NEXT_PUBLIC_DATA_SOURCE=api
# Empty = same-origin (Next Route Handlers)
NEXT_PUBLIC_API_BASE_URL=
# Media: local (base64) | uploads (uploads route → Google Drive) | cloudinary
NEXT_PUBLIC_MEDIA_PROVIDER=uploads
# Public origin for absolute image URLs (no trailing slash). On Vercel set the production domain.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# When using api without var_phan_quyen rows, leave matrix off; login sets cap_bac as super when cap_bac=1
NEXT_PUBLIC_USE_PERMISSION_MATRIX=false
# Optional shared secret — allows POST /uploads via X-Upload-Key header without a session (server-to-server/script uploads)
UPLOAD_API_KEY=change-me-to-a-long-random-upload-key

# Cloudinary — unsigned upload preset only (never put API secret in client), only needed if NEXT_PUBLIC_MEDIA_PROVIDER=cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Optional
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_AUTH_EMAIL_SUFFIX=@gmail.com
# NEXT_PUBLIC_ADMIN_POSITION_MA=CEO
# TV wallboard weather (Open-Meteo) — default Bình Dương
# NEXT_PUBLIC_TV_WEATHER_LAT=10.9804
# NEXT_PUBLIC_TV_WEATHER_LON=106.6519
# NEXT_PUBLIC_TV_WEATHER_LOCATION=Bình Dương
