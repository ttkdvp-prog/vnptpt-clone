# Server only — Postgres (never prefix with NEXT_PUBLIC_)
# Password special chars must be URL-encoded (@ → %40)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/DATABASE
JWT_SECRET=change-me-to-a-long-random-string
AUTH_SECRET=change-me-to-a-long-random-string
API_PORT=3001
API_ORIGIN=http://localhost:3001
# Comma-separated allowed browser origins (CORS). Production example:
# CLIENT_ORIGINS=https://anhungthinh.5fedu.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000

# Client — data source: mock | api
NEXT_PUBLIC_DATA_SOURCE=api
# Empty = same-origin (Next Route Handlers)
NEXT_PUBLIC_API_BASE_URL=
# Media: local (base64) | uploads (VPS/local disk) | cloudinary
NEXT_PUBLIC_MEDIA_PROVIDER=uploads
# Public origin for absolute image URLs (no trailing slash). On VPS set production domain.
NEXT_PUBLIC_APP_URL=https://anhungthinh.5fedu.com
# Server-only — local disk root when NOT forwarding (VPS: /data/uploads)
UPLOAD_DIR=./.data/uploads
# Dev → VPS: local Next proxies POST /uploads to production (server-to-server, no browser CORS)
# Same UPLOAD_API_KEY must be set on Coolify/VPS. Leave UPLOAD_REMOTE_BASE_URL empty on VPS.
UPLOAD_REMOTE_BASE_URL=https://anhungthinh.5fedu.com
UPLOAD_API_KEY=change-me-to-a-long-random-upload-key
# When using api without var_phan_quyen rows, leave matrix off; login sets cap_bac as super when cap_bac=1
NEXT_PUBLIC_USE_PERMISSION_MATRIX=false

# Cloudinary — unsigned upload preset only (never put API secret in client)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Optional
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_AUTH_EMAIL_SUFFIX=@gmail.com
# NEXT_PUBLIC_ADMIN_POSITION_MA=CEO
# TV wallboard weather (Open-Meteo) — default Bình Dương
# NEXT_PUBLIC_TV_WEATHER_LAT=10.9804
# NEXT_PUBLIC_TV_WEATHER_LON=106.6519
# NEXT_PUBLIC_TV_WEATHER_LOCATION=Bình Dương
